<form class="search" role="search" action="" method="get">
    <input type="search" name="supplier" placeholder="Search suppliers" aria-label="Search suppliers">
    <select name="rating" aria-label="Select pound rating">
        <option value="">Select pound rating</option>
        <?php for ($rating = 1; $rating <= 5; $rating++): ?>
            <option value="<?= $rating ?>"><?= $rating ?></option>
        <?php endfor; ?>
    </select>
    <button type="reset">Reset</button>
    <button type="submit">Search</button>
</form>
<div class="table-wrap">
    <table>
        <thead><tr><th scope="col">Supplier</th><th scope="col">Pound Rating</th><th scope="col">Reference</th><th scope="col">Value</th></tr></thead>
        <tbody>
        <?php foreach ($payments as $payment): ?>
            <tr>
                <td><?= htmlspecialchars($payment->getPaymentSupplier(), ENT_QUOTES, 'UTF-8') ?></td>
                <td class="rating" aria-label="<?= (int) $payment->getPaymentCostRating() ?> out of 5 pounds">
                    <?php for ($i = 1; $i <= 5; $i++): ?>
                        <img src="/src/Local/CouncilPayments/view/assets/images/Rating<?= $i <= (int) $payment->getPaymentCostRating() ? 'On' : 'Off' ?>.png" alt="">
                    <?php endfor; ?>
                </td>
                <td><?= htmlspecialchars($payment->getPaymentRef(), ENT_QUOTES, 'UTF-8') ?></td>
                <td>£<?= htmlspecialchars(number_format((float) $payment->getPaymentAmount(), 2), ENT_QUOTES, 'UTF-8') ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>
<?php if ($totalPages > 1): ?>
    <nav class="pagination" aria-label="Pagination">
        <?php if ($page > 1): ?>
            <a href="?<?= htmlspecialchars(http_build_query(array_merge($query, ['page' => min($page - 1, $totalPages)])), ENT_QUOTES, 'UTF-8') ?>" aria-label="Previous page">‹</a>
        <?php endif; ?>
        <?php $windowPage = min($page, $totalPages); ?>
        <?php for ($number = max(1, min($windowPage - 2, $totalPages - 4)); $number <= min($totalPages, max(5, $windowPage + 2)); $number++): ?>
            <?php if ($number === $page): ?>
                <span aria-current="page"><?= $number ?></span>
            <?php else: ?>
                <a href="?<?= htmlspecialchars(http_build_query(array_merge($query, ['page' => $number])), ENT_QUOTES, 'UTF-8') ?>"><?= $number ?></a>
            <?php endif; ?>
        <?php endfor; ?>
        <?php if ($page < $totalPages): ?>
            <a href="?<?= htmlspecialchars(http_build_query(array_merge($query, ['page' => $page + 1])), ENT_QUOTES, 'UTF-8') ?>" aria-label="Next page">›</a>
        <?php endif; ?>
    </nav>
<?php endif; ?>
