<form id="payment-search" class="search" role="search" action="" method="get">
    <input type="search" name="supplier" placeholder="Search suppliers" aria-label="Search suppliers" value="<?= htmlspecialchars($supplier, ENT_QUOTES, 'UTF-8') ?>">
    <select name="rating" aria-label="Select pound rating">
        <option value="">Select pound rating</option>
        <?php for ($option = 1; $option <= 5; $option++): ?>
            <option value="<?= $option ?>"<?= $rating === $option ? ' selected' : '' ?>><?= $option ?></option>
        <?php endfor; ?>
    </select>
    <a class="reset" href="?">Reset</a>
    <button type="submit">Search</button>
</form>
<div class="table-wrap">
    <table>
        <thead><tr><th scope="col">Supplier</th><th scope="col">Pound Rating</th><th scope="col">Reference</th><th scope="col">Value</th></tr></thead>
        <tbody>
        <?php if (count($payments) === 0): ?>
            <tr><td colspan="4">No payments found</td></tr>
        <?php endif; ?>
        <?php foreach ($payments as $payment): ?>
            <tr>
                <td><?= htmlspecialchars($payment->getPaymentSupplier(), ENT_QUOTES, 'UTF-8') ?></td>
                <td class="rating" aria-label="<?= (int) $payment->getPaymentCostRating() ?> out of 5 pounds">
                    <?php for ($i = 1; $i <= 5; $i++): ?>
                        <img src="/src/Local/CouncilPayments/view/assets/images/Rating<?= $i <= (int) $payment->getPaymentCostRating() ? 'On' : 'Off' ?>.png" alt="">
                    <?php endfor; ?>
                </td>
                <td><?= htmlspecialchars($payment->getPaymentRef(), ENT_QUOTES, 'UTF-8') ?></td>
                <td>£<?= htmlspecialchars(number_format((float) $payment->getPaymentAmount(), 2), ENT_QUOTES, 'UTF-8') ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>
<?php if ($totalPages > 1): ?>
    <nav class="pagination" aria-label="Pagination">
        <?php if ($page > 1): ?>
            <button type="submit" form="payment-search" name="page" value="<?= $page - 1 ?>" aria-label="Previous page">‹</button>
        <?php endif; ?>
        <?php $startPage = max(1, min($page - 2, $totalPages - 4)); ?>
        <?php $endPage = min($totalPages, max(5, $page + 2)); ?>
        <?php for ($number = $startPage; $number <= $endPage; $number++): ?>
            <?php if ($number === $page): ?>
                <span aria-current="page"><?= $number ?></span>
            <?php else: ?>
                <button type="submit" form="payment-search" name="page" value="<?= $number ?>"><?= $number ?></button>
            <?php endif; ?>
        <?php endfor; ?>
        <?php if ($page < $totalPages): ?>
            <button type="submit" form="payment-search" name="page" value="<?= $page + 1 ?>" aria-label="Next page">›</button>
        <?php endif; ?>
    </nav>
<?php endif; ?>
